########################################################################
########################################################################
######################## FORMALITY LEC SETUP ###########################
########################################################################
########################################################################

########################################################################
# User variables
########################################################################

set DESIGN      "cv32e40p"

set PRJT_BASE   "/home/xmen-aluno/physical_design_AnaBeatriz/hands/CV32E40P---7"
#set PRJT_BASE   "/home/marcos.leal/Desktop/Physical_Design_MarcosLeal/CV32E40P/CV32E40P---7"

set DB_DIR      "${PRJT_BASE}/db"
set RTL_DIR     "${PRJT_BASE}/rtl"
set OUT_DIR     "${PRJT_BASE}/outputs"
set RPT_DIR     "${PRJT_BASE}/rpt"

set SVF_FILE    "${OUT_DIR}/${DESIGN}.svf"

set REF_RTL     "${RTL_DIR}/${DESIGN}.v"
set IMP_NETLIST "${OUT_DIR}/${DESIGN}.v"

set LIB_DB      "${DB_DIR}/saed32rvt_tt0p85v25c.db"

########################################################################
# Create report directory
########################################################################

file mkdir ${RPT_DIR}/formality


########################################################################
########################################################################
######################## FORMALITY CONFIG ##############################
########################################################################
########################################################################

# Recommended when the netlist was generated by Synopsys DC
set synopsys_auto_setup true

# Read SVF generated during synthesis
set_svf ${SVF_FILE}


########################################################################
########################################################################
######################## READ REFERENCE DESIGN #########################
########################################################################
########################################################################

# Reference = RTL original design
# -r means reference side

read_db -r ${LIB_DB}

read_sverilog ${RTL_DIR}/include/cv32e40p_apu_core_pkg.sv
read_sverilog ${RTL_DIR}/include/cv32e40p_fpu_pkg.sv
read_sverilog ${RTL_DIR}/include/cv32e40p_pkg.sv
 
read_sverilog ${RTL_DIR}/cv32e40p_if_stage.sv
read_sverilog ${RTL_DIR}/cv32e40p_cs_registers.sv
read_sverilog ${RTL_DIR}/cv32e40p_register_file_ff.sv
read_sverilog ${RTL_DIR}/cv32e40p_load_store_unit.sv
read_sverilog ${RTL_DIR}/cv32e40p_id_stage.sv
read_sverilog ${RTL_DIR}/cv32e40p_aligner.sv
read_sverilog ${RTL_DIR}/cv32e40p_decoder.sv
read_sverilog ${RTL_DIR}/cv32e40p_compressed_decoder.sv
read_sverilog ${RTL_DIR}/../bhv/cv32e40p_sim_clock_gate.sv
read_sverilog ${RTL_DIR}/cv32e40p_fifo.sv
read_sverilog ${RTL_DIR}/cv32e40p_prefetch_buffer.sv
read_sverilog ${RTL_DIR}/cv32e40p_hwloop_regs.sv
read_sverilog ${RTL_DIR}/cv32e40p_mult.sv
read_sverilog ${RTL_DIR}/cv32e40p_int_controller.sv
read_sverilog ${RTL_DIR}/cv32e40p_ex_stage.sv
read_sverilog ${RTL_DIR}/cv32e40p_alu_div.sv
read_sverilog ${RTL_DIR}/cv32e40p_alu.sv
read_sverilog ${RTL_DIR}/cv32e40p_ff_one.sv
read_sverilog ${RTL_DIR}/cv32e40p_popcnt.sv
read_sverilog ${RTL_DIR}/cv32e40p_apu_disp.sv
read_sverilog ${RTL_DIR}/cv32e40p_controller.sv
read_sverilog ${RTL_DIR}/cv32e40p_obi_interface.sv
read_sverilog ${RTL_DIR}/cv32e40p_prefetch_controller.sv
read_sverilog ${RTL_DIR}/cv32e40p_sleep_unit.sv
read_sverilog ${RTL_DIR}/cv32e40p_core.sv
read_sverilog ${RTL_DIR}/cv32e40p_top.sv

set_top r:/WORK/cv32e40p_top


########################################################################
########################################################################
###################### READ IMPLEMENTATION DESIGN ######################
########################################################################
########################################################################

# Implementation = synthesized mapped netlist
# -i means implementation side

read_db -i ${LIB_DB}

read_verilog -i ${IMP_NETLIST}

set_top i:/WORK/cv32e40p_top


########################################################################
########################################################################
######################## MATCH AND VERIFY ##############################
########################################################################
########################################################################

# Match reference and implementation points
match

# Generate reports after match
report_matched_points     > ${RPT_DIR}/formality/${DESIGN}_matched_points.rpt
report_unmatched_points   > ${RPT_DIR}/formality/${DESIGN}_unmatched_points.rpt

# Run equivalence checking
verify

# Final reports
report_passing_points     > ${RPT_DIR}/formality/${DESIGN}_passing_points.rpt
report_failing_points     > ${RPT_DIR}/formality/${DESIGN}_failing_points.rpt
report_aborted_points     > ${RPT_DIR}/formality/${DESIGN}_aborted_points.rpt
report_unverified_points  > ${RPT_DIR}/formality/${DESIGN}_unverified_points.rpt

########################################################################
########################################################################
############################ EXIT ######################################
########################################################################
########################################################################

echo "*********************************************************************************"
echo "*********************************************************************************"
puts "\[VIRTUS-CC\] Logic Equivalence Check for Pre-Layout of the ${DESIGN} has been completed."
echo "*********************************************************************************"
echo "*********************************************************************************"

# exit

exit
