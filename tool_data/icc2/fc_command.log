source      "/home/xmen-aluno/physical_design_AnaBeatriz/hands/CV32E40P---7/tool_data/icc2/setup/tech_setup.tcl"
source      "/home/xmen-aluno/physical_design_AnaBeatriz/hands/CV32E40P---7/tool_data/icc2/setup/icc2_setup.tcl"
###############################################################################
# Design Setup
###############################################################################
set DESIGN_STAGE        "01_init_design"
printvar search_path
printvar link_library
###############################################################################
# ICC2 Create Design Library
###############################################################################
#create_lib -technology $TECH_FILE -ref_libs $REFERENCE_LIBRARY ../../../outputs/${DESIGN}.dlib
if { [file exists $PRJT_BASE/dlib/${DESIGN}.dlib] } {
    file delete -force $PRJT_BASE/dlib/${DESIGN}.dlib
}
create_lib -ref_libs $REFERENCE_LIBRARY ${DLIB_DIR}/${DESIGN}.dlib
save_lib
open_lib             ${DLIB_DIR}/${DESIGN}.dlib
report_lib  $PRJT_BASE/dlib/${DESIGN}.dlib             -nosplit             -timing_arcs             -parasitic_tech             -physical             -antenna             -routability             -pattern_must_join_pin             -placement_constraints             -wire_tracks             -wire_track_colors             -verbose             -include_db_mapping
set DESIGN_RTL_DIR "${PRJT_BASE}/rtl"
set RTL_MANIFEST   "${PRJT_BASE}/cv32e40p_manifest.flist"
analyze -format sverilog -vcs "-f ${RTL_MANIFEST}"
elaborate cv32e40p_top
set_top_module cv32e40p_top
current_block
set_svf    ${OUT_DIR}/$DESIGN.svf
source  $PRJT_BASE/tool_data/icc2/setup/scenarios.tcl -echo -verbose
compile_fusion







redirect $::sh_dev_null { set_app_options -name opt.internal.current_block_utilization -value [report_utilization] }

















report_optimization_history
report_area
report_qor
current_block
save_block
save_lib
exit
